# 本机环境配置，可复制为.env；不提交密钥。
# 也可在本机管理台保存API设置，保存值优先于env。GET不返回key。
PORT=3000
# AIKP_ADMIN_TOKEN=optional-explicit-local-admin-token
# AIKP_DATA_DIR=data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT=4000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_OUTPUT=4000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT=4000
# QQ的apiBaseUrl/accessToken/secret/enabled由管理台独立保存。
# callback使用独立secret的HMAC-SHA1签名，不能用AIKP_ADMIN_TOKEN作QQ凭证。
