# 本机环境配置，可复制为.env；不提交密钥。
# 也可在本机管理台保存API设置，保存值优先于env。GET不返回key。
PORT=3000
# AIKP_ADMIN_TOKEN=optional-explicit-local-admin-token
# AIKP_DATA_DIR=data
# OpenRouter（新平台推荐）：一个 key 可用多家模型。每个团还能单独设置主力/辅助模型。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_OUTPUT=8000
# 推理强度：none / minimal / low / medium / high / xhigh
OPENROUTER_REASONING_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT=4000
# 接口模式：responses（OpenAI 官方 Responses API）或 chat（Chat Completions，用于兼容接口/第三方中转，配合 OPENAI_BASE_URL）
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_OUTPUT=4000
# DeepSeek（OpenAI 兼容接口）：deepseek-v4-pro 质量更好，deepseek-flash 更便宜。思考模式默认开启，推理强度填 none 可关闭。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_OUTPUT=8000
DEEPSEEK_REASONING_EFFORT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT=4000
# QQ的apiBaseUrl/accessToken/secret/enabled由管理台独立保存。
# callback使用独立secret的HMAC-SHA1签名，不能用AIKP_ADMIN_TOKEN作QQ凭证。
