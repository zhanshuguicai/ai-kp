{
  "name": "ai-kp-local",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"dist/tests/**/*.test.js\"",
    "platform": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/src/platform/server.js",
    "eval": "npm run build && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/eval.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  }
}
